
@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml

title Диаграмма системного контекста интеллектуального HR-ассистента (C4-L1)

LAYOUT_TOP_DOWN()

Person(employee, "Сотрудник компании", "Задает HR-вопросы, получает ответы, просматривает историю диалогов и оценивает ответы")

Person(hrbp, "HR-бизнес-партнер", "Получает уведомления о нестандартных обращениях сотрудников")

Person(admin, "Ответственный за базу знаний", "Обновляет информацию в корпоративной базе знаний")

System(assistant, "Интеллектуальный HR-ассистент", "Автоматизирует обработку типовых HR-вопросов и передает нестандартные обращения HR-бизнес-партнерам")

System_Ext(llm, "Сервис языковой модели", "Генерирует ответы на основе предоставленного контекста")

Rel(employee, assistant, "Задает вопросы, просматривает историю, оценивает ответы", "HTTPS")

Rel(hrbp, assistant, "Просматривает уведомления об обращениях", "HTTPS")

Rel(admin, assistant, "Обновляет базу знаний", "HTTPS")

Rel(assistant, llm, "Передает контекст и запрос на генерацию ответа", "HTTPS/REST")

SHOW_LEGEND()

@enduml
